# Copy to .env.local (git-ignored) to change the store backend.

# "mock" (default): the demo store runs in the browser with seeded data.
# "shopify": read products and carts from a Shopify development store.
NEXT_PUBLIC_STORE_BACKEND=mock

# Only used when NEXT_PUBLIC_STORE_BACKEND=shopify.
# Use a DEVELOPMENT store and a *public* Storefront API access token. Never commit real values.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
# Optional. A supported Storefront API version (defaults to 2026-07).
NEXT_PUBLIC_SHOPIFY_API_VERSION=
